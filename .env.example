
########################################
# Redis
########################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379

########################################
# JWT
########################################
JWT_SECRET=change-me-to-a-long-random-string

########################################
# Gateway
########################################
ALLOWED_ORIGINS=http://localhost:8000,https://localhost:8000,https://localhost:8443,http://127.0.0.1:3000,http://127.0.0.1:8000
LOG_LEVEL=info

########################################
# TMDB API (required — https://www.themoviedb.org/settings/api)
########################################
TMDB_API_KEY=your-tmdb-api-key-here

########################################
# SMTP
########################################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Hypertube
FRONTEND_URL=https://localhost:8443

########################################
# OAuth2 — 42 School (https://profile.intra.42.fr/oauth/applications)
########################################
OAUTH_42_CLIENT_ID=your-42-client-id
OAUTH_42_CLIENT_SECRET=your-42-client-secret
OAUTH_42_REDIRECT_URI=https://localhost:8443/api/v1/auth/oauth/42/callback

########################################
# OAuth2 — GitHub (https://github.com/settings/developers)
########################################
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
OAUTH_GITHUB_REDIRECT_URI=https://localhost:8443/api/v1/auth/oauth/github/callback

########################################
# Subtitles (optional — https://www.opensubtitles.com/consumers)
########################################
OPENSUBTITLES_API_KEY=your-opensubtitles-api-key-here
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

########################################
# Frontend (Next.js)
########################################
NEXT_PUBLIC_API_URL=https://localhost:8443/api/v1

########################################
# Flags
########################################
GIN_MODE=release
AUTO_MIGRATE=true
LOG_LEVEL=info
# Worker — durée avant suppression des fichiers non visionnés (jours)
CLEANUP_EXPIRY_DAYS=30
